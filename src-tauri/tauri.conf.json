{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BeatCrate",
  "mainBinaryName": "BeatCrate",
  "version": "1.0.1",
  "identifier": "com.beatcrate.app",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BeatCrate",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#060a07"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://fonts.googleapis.com https://fonts.gstatic.com",
      "dangerousDisableAssetCspModification": ["script-src", "style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/Library/Application Support/BeatCrate/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "dmg",
    "category": "Music",
    "copyright": "© 2026 Andrew Foster",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
